{
  "name": "@gramaziokohler/compas-threejs",
  "private": true,
  "version": "0.0.0",
  "description": "A Three.js viewer for COMPAS using TypeScript and Protobuf",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gramaziokohler/compas_threejs_ts.git"
  },
  "homepage": "https://github.com/gramaziokohler/compas_threejs_ts#readme",
  "bugs": {
    "url": "https://github.com/gramaziokohler/compas_threejs_ts/issues"
  },
  "keywords": [
    "compas",
    "threejs",
    "viewer",
    "protobuf",
    "geometry"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@11.19.0",
  "types": "./dist-lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist-lib/index.d.ts",
      "import": "./dist-lib/index.js"
    },
    "./style.css": "./dist-lib/style.css"
  },
  "files": [
    "dist-lib",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && npm run build:app && npm run build:library",
    "build:app": "vite build",
    "build:library": "vite build --config vite.config.library.ts && node scripts/copy-library-types.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --ext .ts,.tsx --max-warnings=0",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,vue,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,vue,json}\""
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.11.0",
    "@gramaziokohler/compas-pb-ts": "^2.0.0",
    "@lucide/vue": "^1.26.0",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@vueuse/core": "^14.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-vue-next": "^0.563.0",
    "protobufjs": "^8.0.0",
    "radix-ui": "^1.4.3",
    "reka-ui": "^2.10.1",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18",
    "vue": "^3.5.25"
  },
  "peerDependencies": {
    "three": "^0.182.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^24.10.13",
    "@typescript-eslint/eslint-plugin": "^8.62.1",
    "@typescript-eslint/parser": "^8.62.1",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "happy-dom": "^20.11.2",
    "prettier": "^3.9.4",
    "three": "^0.182.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.62.1",
    "vite": "^7.3.1",
    "vite-tsconfig-paths": "^6.1.0",
    "vitest": "^4.1.10",
    "vue-component-type-helpers": "^3.2.4",
    "vue-tsc": "^3.1.5"
  }
}
